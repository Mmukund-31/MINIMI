# ─────────────────────────────────────────────────────────────────────────────
# MINIMI Research Agent: environment configuration
# Copy to `.env` and fill in the keys. `.env` is gitignored.
# The app starts without keys, and /api/health reports what is missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider ────────────────────────────────────────────────────────────
# Which provider powers the agent: groq | anthropic | openai
#   groq       → https://console.groq.com/keys (free tier; default)
#   anthropic  → https://console.anthropic.com/
#   openai     → any OpenAI-compatible endpoint (set OPENAI_BASE_URL)
LLM_PROVIDER=groq

# Optional (recommended when you have an Anthropic key): use a different provider
# only for the final streamed answer: Groq for the fast structured stages, Claude
# for the prose.
# LLM_SYNTHESIS_PROVIDER=anthropic

GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model overrides per role. Defaults depend on the provider:
#   groq:      fast=openai/gpt-oss-20b, extract=openai/gpt-oss-120b, synthesis=openai/gpt-oss-20b
#              (Groq's free tier limits tokens/minute per model; splitting roles across
#               two models keeps one research request inside both buckets)
#   anthropic: claude-opus-5-5 for every role; set claude-sonnet-5-5 or claude-haiku-5-5 to reduce cost
#   openai:    gpt-5-mini
# fast      = intent analysis + research planning (small structured outputs)
# extract   = evidence extraction from search results (long input, verbatim quotes)
# synthesis = the streamed answer (general "direct" answers use the extract model
#             when it is on the same provider: it is idle on that path)
# LLM_MODEL_FAST=
# LLM_MODEL_EXTRACT=
# LLM_MODEL_SYNTHESIS=

# ── Web search (the agent's single tool) ────────────────────────────────────
# https://app.tavily.com/ (free tier: 1,000 credits / month)
TAVILY_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
# Fallback IANA timezone for date reasoning ("last Tuesday") when the browser
# does not send one. Defaults to the server's system timezone.
# APP_TIMEZONE=Europe/London
DATABASE_PATH=data/minimi.db
# Seed the clearly-labelled demo conversations on first start (empty DB).
SEED_DEMO_DATA=true
LOG_LEVEL=info

# ── Execution budgets (hard limits enforced by the orchestrator) ────────────
MAX_SEARCHES=10
MAX_RESULTS_PER_SEARCH=5
MAX_SOURCES=12
SEARCH_TIMEOUT_MS=15000
LLM_TIMEOUT_MS=90000
MAX_LLM_CALLS=8
MAX_EXECUTION_MS=180000
MAX_CONTEXT_CHARS=24000
SEARCH_CACHE_TTL_HOURS=6
